<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="CineBo Test"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Zugang zum KI-Chip (Hexagon) über Qualcomms FastRPC-Bibliothek des Herstellers. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <!-- Auf- und Zuklappen startet die Ansicht nicht neu: So lässt sich prüfen,
             ob eine laufende Aufnahme das Klappen übersteht. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|colorMode|fontScale|fontWeightAdjustment|layoutDirection|locale|touchscreen"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gibt den Testbericht als Datei an andere Apps weiter (Knopf „Teilen“). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateien" />
        </provider>
    </application>
</manifest>
